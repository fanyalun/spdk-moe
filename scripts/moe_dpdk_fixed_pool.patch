diff --git a/lib/eal/linux/eal_moe_memory.h b/lib/eal/linux/eal_moe_memory.h
new file mode 100644
index 0000000000..4600318b5f
--- /dev/null
+++ b/lib/eal/linux/eal_moe_memory.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef EAL_MOE_MEMORY_H
+#define EAL_MOE_MEMORY_H
+#include <stdint.h>
+
+static inline int
+eal_moe_limit_pages(uint64_t bytes, uint64_t page_size, unsigned sizes, uint32_t *pages)
+{
+	if (sizes != 1 || page_size != UINT64_C(2097152) || bytes == 0 ||
+	    bytes % page_size != 0 || bytes / page_size > UINT32_MAX)
+		return -1;
+	uint32_t limit = bytes / page_size;
+	if (*pages > limit)
+		*pages = limit;
+	return 0;
+}
+#endif
